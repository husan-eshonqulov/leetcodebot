{
  "name": "leetcodeuzbot",
  "type": "module",
  "scripts": {
    "build": "tsc --outDir dist",
    "start": "node dist/index.js",
    "start:dev": "tsx watch --clear-screen=false --env-file=.env src/index.ts",
    "format": "prettier --ignore-unknown --write .",
    "lint": "eslint --fix .",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.0.1",
    "@grammyjs/i18n": "^1.1.2",
    "@prisma/client": "^6.5.0",
    "cron": "^4.1.0",
    "grammy": "^1.35.0",
    "p-limit": "^6.2.0",
    "redis": "^5.0.1"
  }
}
