{
  "name": "leetcodebot",
  "version": "0.1.0",
  "description": "A LeetCode bot",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "docker:compose:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:compose:down": "docker compose -f docker-compose.dev.yml down",
    "prisma:migrate": "dotenv prisma migrate dev",
    "prisma:db:push": "dotenv prisma db push",
    "prisma:generate": "dotenv prisma generate",
    "prisma:studio": "dotenv prisma studio",
    "build": "tsc --outDir dist",
    "start": "node dist/src/index.js",
    "start:dev": "tsx watch --clear-screen=false --env-file=.env src/index.ts",
    "lint": "eslint --fix .",
    "format": "prettier --ignore-unknown --write .",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/i18n": "^1.1.2",
    "@grammyjs/menu": "^1.3.1",
    "@grammyjs/storage-redis": "^2.5.1",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "grammy": "^1.38.4",
    "ioredis": "^5.8.2",
    "iso-639-1": "^3.1.5",
    "pg": "^8.16.3",
    "winston": "^3.19.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "prisma": "^7.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  }
}
